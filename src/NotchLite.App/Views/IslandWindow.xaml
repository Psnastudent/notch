                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding ToggleTimerCommand}">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="#FFFFFF">
                                                <Path Data="{StaticResource GeomPlay}" Fill="#000000" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding AdjustTimerCommand}" CommandParameter="-5" Margin="8,0,4,0">
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#2A2C33">
                                                <TextBlock Text="-" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding AdjustTimerCommand}" CommandParameter="5" Margin="4,0">
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#2A2C33">
                                                <TextBlock Text="+" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Widget 3: Weather (Bottom Left) -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#18191E" CornerRadius="18" Padding="16,12" Margin="0,6,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding WeatherTemp}" Foreground="#FFFFFF" FontSize="28" FontWeight="Bold"/>
                                    <Path Data="{StaticResource GeomRain}" Fill="#8E929E" Stretch="Uniform" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding WeatherCondition}" Foreground="#8E929E" FontSize="13"/>
                                    <TextBlock Text="{Binding WeatherHighLow}" Foreground="#8E929E" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Widget 4: System Monitor (Bottom Right) -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#18191E" CornerRadius="18" Padding="16,10" Margin="6,6,0,0">
                            <StackPanel>
                                <!-- CPU -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" Foreground="#8E929E" FontSize="11" FontWeight="SemiBold"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding CpuPercent}" Maximum="100" Height="3" Foreground="#FFFFFF" Background="#2A2C33" BorderThickness="0" VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat={}{0}%}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- GPU -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" Foreground="#8E929E" FontSize="11" FontWeight="SemiBold"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding GpuPercent}" Maximum="100" Height="3" Foreground="#A855F7" Background="#2A2C33" BorderThickness="0" VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding GpuPercent, StringFormat={}{0}%}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- RAM -->
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" Foreground="#8E929E" FontSize="11" FontWeight="SemiBold"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding RamPercent}" Maximum="100" Height="3" Foreground="#F97316" Background="#2A2C33" BorderThickness="0" VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RamPercent, StringFormat={}{0}%}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
