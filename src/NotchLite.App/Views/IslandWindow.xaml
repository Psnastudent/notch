                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeomMoon}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                            <TextBlock Text="Night light" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Off" Foreground="#8E929E" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Focus -->
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding ToggleFocusCommand}">
                                    <Border CornerRadius="16" Padding="12,10" Margin="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#24252B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFocusOn}" Value="True">
                                                        <Setter Property="Background" Value="#8B5CF6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeomFocus}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                            <TextBlock Text="Focus" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Off" Foreground="#8E929E" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Mute -->
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding ToggleMuteCommand}">
                                    <Border CornerRadius="16" Padding="12,10" Margin="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#24252B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeomSpeaker}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                            <TextBlock Text="Mute" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Sound on" Foreground="#8E929E" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Battery Status -->
                                <Border Background="#24252B" CornerRadius="16" Padding="12,10" Margin="4">
                                    <StackPanel VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomBattery}" Fill="#22C55E" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                        <TextBlock Text="100%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Plugged in" Foreground="#8E929E" FontSize="11"/>
                                    </StackPanel>
                                </Border>
