                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#3B3D46" BorderThickness="1" CornerRadius="14" Width="60" Height="60" Margin="4" Cursor="Hand">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="+" Foreground="#8E929E" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Add" Foreground="#8E929E" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#3B3D46" BorderThickness="1" CornerRadius="14" Width="60" Height="60" Margin="4" Cursor="Hand">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="+" Foreground="#8E929E" FontSize="16" HorizontalAlignment="Center"/>
