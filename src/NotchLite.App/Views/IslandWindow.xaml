                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Center Notification Bell Badge -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                Width="36" Height="36" CornerRadius="18" Background="#282930" BorderBrush="#141519" BorderThickness="3"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeomBell}" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- 5. CONTROL CENTER TAB (Screenshot 10 with interactive capsule sliders and toggles) -->
                    <Border x:Name="TabControlsContent" Grid.Row="1" CornerRadius="18" Padding="16,14" Background="#141519" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Interactive Brightness Capsule Slider -->
                            <Border Grid.Row="0" Grid.Column="0" Width="68" Height="140" CornerRadius="18" Background="#24252B" Margin="0,0,10,12" ClipToBounds="True" Cursor="Hand" MouseDown="OnBrightnessCapsuleMouseDown" MouseMove="OnBrightnessCapsuleMouseMove">
                                <Grid>
                                    <Border VerticalAlignment="Bottom" Height="45" Background="#FFFFFF" CornerRadius="18,18,0,0" x:Name="BrightnessFillBorder"/>
