                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#24252B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Data="{StaticResource GeomMic}" Fill="#FFFFFF" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <TextBlock Text="Mic on" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Click to mute" Foreground="#8E929E" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Right Controls -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ready for calls" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Test your mic and speaker before you join." Foreground="#8E929E" FontSize="13" Margin="0,2,0,12"/>

                                <!-- Speakers Row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#24252B" CornerRadius="12" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomHeadset}" Fill="#8E929E" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SelectedSpeaker}" Foreground="#FFFFFF" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource DarkPillBtn}" Command="{Binding TestAudioCommand}" Content="Test" Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Microphone Row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#24252B" CornerRadius="12" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeomMic}" Fill="#8E929E" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SelectedMic}" Foreground="#FFFFFF" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource DarkPillBtn}" Command="{Binding TestAudioCommand}" Content="Test" Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Camera Button -->
                                <Button Style="{StaticResource DarkPillBtn}" Command="{Binding CheckCameraCommand}" HorizontalAlignment="Left" Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeomCamera}" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Check camera"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
