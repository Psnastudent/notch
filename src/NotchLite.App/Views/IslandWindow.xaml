                            <!-- Bottom Power Mode Pills -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SetPowerModeCommand}" CommandParameter="Battery" Margin="6,0">
