<Window x:Class="NotchLite.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NotchLite.App.ViewModels"
        xmlns:models="clr-namespace:NotchLite.Core.Models;assembly=NotchLite.Core"
        Title="Zenith Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="720"
        Height="360"
        ResizeMode="NoResize"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave"
        Loaded="OnWindowLoaded">

    <!-- Container Grid with Hardware Acceleration Cache -->
    <Grid Margin="16" x:Name="RootContainerGrid" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.CacheMode>
            <BitmapCache EnableClearType="True" RenderAtScale="1"/>
        </Grid.CacheMode>

        <!-- Drop Shadow for floating depth -->
        <Border x:Name="ShadowBorder"
                CornerRadius="20"
                Width="220"
                Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#000000"
                Opacity="0.4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.6"/>
            </Border.Effect>
        </Border>

        <!-- Main Outer Shell Border (Morphs smoothly between Resting and Open) -->
        <Border x:Name="MainShellBorder"
                Width="220"
                Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#0B0C0E"
                BorderBrush="#2A2C33"
                BorderThickness="1"
                CornerRadius="19"
                ClipToBounds="True">

            <!-- Dynamic Content Container -->
            <Grid>
                <!-- RESTING STATE (Pill with live pulsating sound visualizer or minimal clock) -->
                <Grid x:Name="RestingGrid"
                      Height="38"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Cursor="Hand"
                      MouseDown="OnRestingGridMouseDown">
                    
                    <!-- When media IS active -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveMedia}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCapsLockHudVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Mini album artwork / icon with pulse -->
                        <Border Width="22" Height="22" CornerRadius="6" Background="#FF3300" Margin="0,0,10,0">
                            <Path Data="{StaticResource GeomMusic}" Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Live Pulsing Visualizer Pixels (Warm Amber Glow) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border Width="4" Height="{Binding Bar1Height}" Background="#FFAA00" CornerRadius="1" Margin="1.5,0"/>
                            <Border Width="4" Height="{Binding Bar2Height}" Background="#FF7700" CornerRadius="1" Margin="1.5,0"/>
                            <Border Width="4" Height="{Binding Bar3Height}" Background="#FFDD00" CornerRadius="1" Margin="1.5,0"/>
                            <Border Width="4" Height="{Binding Bar4Height}" Background="#FF5500" CornerRadius="1" Margin="1.5,0"/>
                            <Border Width="4" Height="{Binding Bar5Height}" Background="#FFAA00" CornerRadius="1" Margin="1.5,0"/>
                            <Border Width="4" Height="{Binding Bar6Height}" Background="#FF3300" CornerRadius="1" Margin="1.5,0"/>
                        </StackPanel>

                        <!-- Pet walking / resting avatar -->
                        <TextBlock Text="🐱" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- When NO media is active: Minimal Sleek Resting Notch -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveMedia}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCapsLockHudVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <Path Data="{StaticResource GeomBattery}" Fill="#30D158" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="100%" Foreground="#8E929E" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Width="1" Height="12" Background="#24FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="🐱" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Mac-Style Caps Lock Overlay (Triggers when Caps Lock is toggled) -->
                    <Border x:Name="CapsLockPill"
                            Background="#F018191E"
                            CornerRadius="16"
                            Padding="12,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapsLockHudVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Mac Caps Lock Arrow ⇪ -->
                            <Path Data="M 6,1 L 1.5,7.5 L 4.5,7.5 L 4.5,12.5 L 7.5,12.5 L 7.5,7.5 L 10.5,7.5 Z M 1.5,14.5 L 10.5,14.5 L 10.5,16.5 L 1.5,16.5 Z"
                                  Fill="{Binding CapsLockIconColor}"
                                  Stretch="Uniform"
                                  Width="13" Height="13"
                                  VerticalAlignment="Center"
                                  Margin="0,0,7,0"/>

                            <!-- Green Dot (ON) / Gray Dot (OFF) -->
                            <Ellipse Width="6" Height="6"
                                     Fill="{Binding CapsLockDotColor}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>

                            <!-- Text: CAPS LOCK / CAPS OFF -->
                            <TextBlock Text="{Binding CapsLockText}"
                                       Foreground="#FFFFFF"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- EXPANDED STATE (Full Card) -->
                <Grid x:Name="ExpandedGrid"
                      Opacity="0"
                      Visibility="Collapsed"
                      Margin="16,10,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Tab Navigation Strip -->
                        <RowDefinition Height="*"/>    <!-- Active Tab Content Area -->
                    </Grid.RowDefinitions>

                    <!-- TOP NAVIGATION TAB STRIP (10 Icons + Active Dot Indicator) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <!-- Tab 0: Music -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Music}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomMusic}" Fill="#FFFFFF" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotMusic" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Visible"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 1: Web -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Web}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomGlobe}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotWeb" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Notices -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Notices}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomBell}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotNotices" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: Shelf -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Shelf}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomFolder}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotShelf" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 4: Clipboard -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Clipboard}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomClipboard}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotClipboard" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 5: Widgets -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Widgets}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomGrid}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotWidgets" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 6: Controls -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Controls}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomSliders}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotControls" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 7: Actions -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Actions}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomDots}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotActions" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 8: Deck -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Deck}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomPhone}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotDeck" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 9: Calls -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static models:IslandTab.Calls}" Margin="7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeomHeadset}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                                <Ellipse x:Name="DotCalls" Width="3" Height="3" Fill="#FFFFFF" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="14" Fill="#3B3D46" Margin="6,0,6,0"/>

                        <!-- Settings Gear -->
                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding OpenSettingsCommand}" Margin="4,0">
                            <Path Data="{StaticResource GeomGear}" Fill="#8E929E" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>

                    <!-- TAB CONTENTS -->
                    <!-- 1. MUSIC PLAYER TAB (Screenshot 11) -->
                    <Border x:Name="TabMusicContent" Grid.Row="1" CornerRadius="18" Padding="16,14" Background="#141519">
                        <!-- Warm glowing aura backdrop -->
                        <Grid>
                            <Grid.Background>
                                <RadialGradientBrush Center="0.2,0.3" RadiusX="0.9" RadiusY="0.9">
                                    <GradientStop Color="#40CC4400" Offset="0.0"/>
                                    <GradientStop Color="#00000000" Offset="0.8"/>
                                </RadialGradientBrush>
                            </Grid.Background>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Track row: Artwork + Details + Playback Buttons -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Artwork with App badge -->
                                    <Grid Grid.Column="0" Margin="0,0,14,0">
                                        <Border Width="56" Height="56" CornerRadius="10" Background="#24252B" ClipToBounds="True">
                                            <Grid>
                                                <Path Data="{StaticResource GeomMusic}" Fill="#FFFFFF" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActiveMedia}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Image Source="{Binding AlbumArtImage}" Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActiveMedia}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Title & Artist -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TrackTitle}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ArtistName}" Foreground="#8E929E" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Playback Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding PrevTrackCommand}" Margin="4,0">
                                            <Path Data="{StaticResource GeomPrev}" Fill="#FFFFFF" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding TogglePlayPauseCommand}" Margin="8,0">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="#FFFFFF">
                                                <Path Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource GeomPlay}"/>
                                                            <Setter Property="Fill" Value="#000000"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource GeomPause}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                        </Button>
                                        <Button Style="{StaticResource BorderlessBtn}" Command="{Binding NextTrackCommand}" Margin="4,0">
                                            <Path Data="{StaticResource GeomNext}" Fill="#FFFFFF" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Audio Progress Bar -->
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding TrackProgressPercent}" Foreground="#FFFFFF" Background="#33FFFFFF" BorderThickness="0"/>
                                </Grid>

                                <!-- Time & Volume Row -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding CurrentTimeString}" Foreground="#8E929E" FontSize="11"/>

                                    <!-- Volume Slider in center -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeomSpeaker}" Fill="#8E929E" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                                        <Slider Width="100" Minimum="0" Maximum="100" Value="{Binding Volume}" Style="{StaticResource HorizontalProgressSlider}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding RemainingTimeString}" Foreground="#8E929E" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2. WEB / SITES TAB (Screenshot 4) -->
                    <Border x:Name="TabWebContent" Grid.Row="1" CornerRadius="18" Padding="18" Background="#141519" Visibility="Collapsed">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Bookmarks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BorderlessBtn}" Command="{Binding DataContext.OpenWebSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <Border Background="#2B1417" CornerRadius="14" Padding="14,10" Margin="0,0,10,10" Width="150" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="30" Height="30" CornerRadius="8" Background="{Binding ColorHex}" Margin="0,0,10,0">
                                                            <Path Data="{StaticResource GeomGlobe}" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="{Binding Domain}" Foreground="#8E929E" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding AddNewWebSiteCommand}">
                                    <Border BorderBrush="#3B3D46" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,10,10" Width="140" Cursor="Hand">
                                        <TextBlock Text="+ Add a site" Foreground="#8E929E" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </Border>
                                </Button>
                            </WrapPanel>

                            <TextBlock Text="Add a site: any page, signed in, one click away." Foreground="#8E929E" FontSize="12" Margin="4,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. SHELF TAB (Screenshot 5 with Real File Drag-and-Drop) -->
                    <Border x:Name="TabShelfContent" Grid.Row="1" CornerRadius="18" Padding="18" Background="#141519" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Shelf" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource ActiveWhitePillBtn}" Command="{Binding SendToPhoneCommand}" Content="📱 Send to phone" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource BorderlessBtn}" Command="{Binding ClearShelfCommand}">
                                        <Path Data="{StaticResource GeomDownload}" Fill="#FFFFFF" Stretch="Uniform" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Interactive Drag-and-Drop Zone -->
                            <Border BorderBrush="#3B3D46" BorderThickness="1" CornerRadius="16" Padding="20,16" Background="#18191E"
                                    AllowDrop="True" Drop="OnShelfDrop" DragOver="OnShelfDragOver">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Path Data="{StaticResource GeomDownload}" Fill="#8E929E" Stretch="Uniform" Width="24" Height="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Drop files here" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="They wait here until you need them" Foreground="#4A90E2" FontSize="13" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Staged Files List -->
                                    <ItemsControl ItemsSource="{Binding ShelfItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#24252B" CornerRadius="10" Padding="10,6" Margin="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Data="{StaticResource GeomFolder}" Fill="#4A90E2" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Style="{StaticResource BorderlessBtn}" Command="{Binding DataContext.OpenShelfFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <TextBlock Text="Open" Foreground="#4A90E2" FontSize="11" FontWeight="SemiBold"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3.5 CLIPBOARD TAB (Copy, Paste, and History Manager) -->
                    <Border x:Name="TabClipboardContent" Grid.Row="1" CornerRadius="18" Padding="16,14" Background="#141519" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Title + Status + Clear Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomClipboard}" Fill="#4A90E2" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clipboard Manager" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Background="#25FFFFFF" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClipboardItems.Count, StringFormat={}{0} items}" Foreground="#A0A5B5" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ClipboardStatusMessage}" Foreground="#1DB954" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource BorderlessBtn}" Command="{Binding ClearClipboardHistoryCommand}" ToolTip="Clear All">
                                        <Border Background="#24252B" CornerRadius="8" Padding="8,4">
                                            <TextBlock Text="Clear All" Foreground="#FF6B6B" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Quick Text Add / Paste Row -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1C1D23" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,4">
                                    <TextBox Text="{Binding NewClipboardText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="12"
                                             VerticalAlignment="Center"
                                             CaretBrush="#FFFFFF">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddCustomClipboardTextCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource ActiveWhitePillBtn}" Command="{Binding AddCustomClipboardTextCommand}" Content="Save &amp; Copy" Margin="8,0,0,0" Height="28"/>
