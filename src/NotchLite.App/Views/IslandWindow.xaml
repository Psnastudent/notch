                                    <Path Data="{StaticResource GeomSun}" Fill="#000000" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                                </Grid>
                            </Border>

                            <!-- Interactive Volume Capsule Slider -->
                            <Border Grid.Row="0" Grid.Column="1" Width="68" Height="140" CornerRadius="18" Background="#FFFFFF" Margin="0,0,16,12" ClipToBounds="True" Cursor="Hand" MouseDown="OnVolumeCapsuleMouseDown" MouseMove="OnVolumeCapsuleMouseMove">
                                <Grid>
                                    <Border VerticalAlignment="Bottom" Height="140" Background="#FFFFFF" CornerRadius="18" x:Name="VolumeFillBorder"/>
                                    <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Foreground="#000000" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"/>
                                    <Path Data="{StaticResource GeomSpeaker}" Fill="#000000" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                                </Grid>
                            </Border>

                            <!-- Quick Toggle 2x3 Grid with real functional clicks -->
                            <UniformGrid Grid.Row="0" Grid.Column="2" Columns="3" Margin="0,0,0,12">
                                <!-- Wi-Fi -->
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding ToggleWifiCommand}">
                                    <Border CornerRadius="16" Padding="12,10" Margin="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#24252B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWifiOn}" Value="True">
                                                        <Setter Property="Background" Value="#1877F2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeomWifi}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                            <TextBlock Text="Wi-Fi" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="On" Foreground="#E0E0E0" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Bluetooth -->
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding ToggleBluetoothCommand}">
                                    <Border CornerRadius="16" Padding="12,10" Margin="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#24252B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBluetoothOn}" Value="True">
                                                        <Setter Property="Background" Value="#1877F2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeomBluetooth}" Fill="#FFFFFF" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                            <TextBlock Text="Bluetooth" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Off" Foreground="#8E929E" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Night light -->
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding ToggleNightLightCommand}">
                                    <Border CornerRadius="16" Padding="12,10" Margin="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#24252B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNightLightOn}" Value="True">
