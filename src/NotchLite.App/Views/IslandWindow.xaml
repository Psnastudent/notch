                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="Focus timer" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
