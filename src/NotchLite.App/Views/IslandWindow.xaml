                                    <TextBlock Text="16" Foreground="#6C707E" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="17" Foreground="#6C707E" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="18" Foreground="#6C707E" FontSize="12" HorizontalAlignment="Center"/>
                                    <Border Background="#3B3D46" CornerRadius="10" Padding="4,2" HorizontalAlignment="Center">
                                        <TextBlock Text="19" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="20" Foreground="#6C707E" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="21" Foreground="#6C707E" FontSize="12" HorizontalAlignment="Center"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Widget 2: Focus Timer (Top Right) -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#18191E" CornerRadius="18" Padding="16,12" Margin="6,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Circular Timer Ring -->
                                <Border Width="50" Height="50" CornerRadius="25" BorderBrush="#4A90E2" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
