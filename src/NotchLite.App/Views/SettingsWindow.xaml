<Window x:Class="NotchLite.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NotchLite.App.ViewModels"
        Title="Zenith Island Settings"
        Width="920"
        Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <!-- Outer Rounded Window Border -->
    <Border Background="#0C0D0F"
            BorderBrush="#25272E"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/> <!-- Titlebar -->
                <RowDefinition Height="*"/>  <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- TITLEBAR -->
            <Grid Grid.Row="0" Background="#111215" MouseDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Zenith Island Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="#2B7FFF" Margin="0,0,8,0">
                        <TextBlock Text="Z" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Zenith Island" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="1.0.0" Foreground="#6C707E" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource BorderlessBtn}" Click="OnCloseButtonClick" Padding="14,0" Height="42" HorizontalAlignment="Right">
                    <TextBlock Text="✕" Foreground="#8E929E" FontSize="13" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- TWO COLUMN MAIN AREA -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/> <!-- Left Sidebar -->
                    <ColumnDefinition Width="*"/>   <!-- Right Content -->
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0" Background="#101114" BorderBrush="#1C1D22" BorderThickness="0,0,1,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Search Box -->
                            <RowDefinition Height="*"/>    <!-- Category List -->
                        </Grid.RowDefinitions>

                        <!-- Search settings -->
                        <Border Grid.Row="0" Background="#18191E" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Foreground="#6C707E" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBox Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12" Width="150"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Category Navigation Items -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="General" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border Background="{Binding SelectedCategory, Converter={x:Null}}" CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="⚙ General" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Accessibility" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="👁 Accessibility" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Appearance" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border Background="#1C1D22" CornerRadius="8" Padding="10,8">
                                        <Grid>
                                            <TextBlock Text="🎨 Appearance" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                            <Ellipse Width="5" Height="5" Fill="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Island" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="🏝 Island" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Taskbar" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="▭ Taskbar" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Panels" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="▦ Panels" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Widgets" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="⏱ Widgets" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Wallpaper" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="🖼 Wallpaper" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Calls" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="🎙 Calls" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Streaming" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="📡 Streaming" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Gaming" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="🎮 Gaming" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="AI agents" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="🤖 AI agents" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Tools" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="⚡ Tools" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="Keys" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="⌨ Keys" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BorderlessBtn}" Command="{Binding SelectCategoryCommand}" CommandParameter="About" HorizontalContentAlignment="Stretch" Margin="0,2">
                                    <Border CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="ℹ About" Foreground="#8E929E" FontSize="13"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT CONTENT PANE -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20">
                    <StackPanel>
                        <!-- LIVE PREVIEW CARD (Screenshots 2 & 3) -->
                        <Border CornerRadius="16" Height="190" Background="#1B1C22" Margin="0,0,0,24" ClipToBounds="True">
                            <Grid>
                                <!-- Gradient mesh backdrop -->
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#251A33" Offset="0.0"/>
                                        <GradientStop Color="#161220" Offset="0.5"/>
                                        <GradientStop Color="#361730" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Grid.Background>

                                <!-- Mini Island preview in center -->
                                <Border Height="34" Width="200" CornerRadius="17" Background="#000000" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="5" Background="#FF4400" Margin="0,0,8,0">
                                            <Path Data="{StaticResource GeomMusic}" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="3" Height="10" Fill="#FF9900" RadiusX="1" RadiusY="1" Margin="1,0"/>
                                            <Rectangle Width="3" Height="14" Fill="#FF6600" RadiusX="1" RadiusY="1" Margin="1,0"/>
                                            <Rectangle Width="3" Height="8" Fill="#FFCC00" RadiusX="1" RadiusY="1" Margin="1,0"/>
                                            <Rectangle Width="3" Height="12" Fill="#FF3300" RadiusX="1" RadiusY="1" Margin="1,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Live preview text at bottom left -->
                                <TextBlock Text="Live preview. Point at the island, play, skip, scrub." Foreground="#8E929E" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,14"/>

                                <!-- Resting / Open toggle buttons at bottom right -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,14">
                                    <Button Style="{StaticResource ActiveWhitePillBtn}" Command="{Binding SetPreviewRestingCommand}" Content="Resting" Padding="12,5" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource DarkPillBtn}" Command="{Binding SetPreviewOpenCommand}" Content="Open" Padding="12,5" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- APPEARANCE SETTINGS SECTION -->
                        <TextBlock Text="APPEARANCE" Foreground="#6C707E" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                        <!-- 1. Shape -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Shape" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Island floats just below the top edge, round all over. Notch hangs from the edge and curves into it, like a MacBook's."
                                           Foreground="#8E929E" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActiveWhitePillBtn}" Command="{Binding SetShapeCommand}" CommandParameter="Island" Content="Island" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DarkPillBtn}" Command="{Binding SetShapeCommand}" CommandParameter="Notch" Content="Notch"/>
                            </StackPanel>
                        </Grid>

                        <!-- 2. Distance from top -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Distance from top" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Space between the top of the screen and the island, or the side of the screen when it sits on a side. The Notch shape always hangs from the edge."
                                           Foreground="#8E929E" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding DistanceFromTop}" Style="{StaticResource HorizontalProgressSlider}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding DistanceFromTop, StringFormat={}{0} px}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 3. When resting, show -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="When resting, show" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="What the island shows while nothing plays and nothing is going on. Music, calls, downloads and timers still take it over."
                                           Foreground="#8E929E" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#18191E" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                                <TextBlock Text="Nothing, just the island  v" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- 4. Pet -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Pet" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Who lives on the resting island. It walks about, sits, blinks and naps; music, calls and timers take the pill over as usual."
                                           Foreground="#8E929E" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActiveWhitePillBtn}" Command="{Binding SetPetCommand}" CommandParameter="Cat" Content="Cat" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DarkPillBtn}" Command="{Binding SetPetCommand}" CommandParameter="Dog" Content="Dog" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DarkPillBtn}" Command="{Binding SetPetCommand}" CommandParameter="Bunny" Content="Bunny"/>
                            </StackPanel>
                        </Grid>

                        <!-- 5. Size -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Size" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="The pill, the card and its text scale together." Foreground="#8E929E" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="70" Maximum="130" Value="{Binding SizePercent}" Style="{StaticResource HorizontalProgressSlider}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding SizePercent, StringFormat={}{0}%}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 6. Open size -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Open size" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="How big the island grows when it opens. The resting pill stays the same; the open card, its text and controls scale with this."
                                           Foreground="#8E929E" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="70" Maximum="140" Value="{Binding OpenSizePercent}" Style="{StaticResource HorizontalProgressSlider}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding OpenSizePercent, StringFormat={}{0}%}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 7. Motion -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Motion" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Fluid moves at your screen's full refresh rate. Battery saver keeps it under 60 frames a second, and Balanced does that only on battery. The island draws nothing while it is still, whichever you pick."
                                           Foreground="#8E929E" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DarkPillBtn}" Command="{Binding SetMotionCommand}" CommandParameter="Fluid" Content="Fluid" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource ActiveWhitePillBtn}" Command="{Binding SetMotionCommand}" CommandParameter="Balanced" Content="Balanced" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DarkPillBtn}" Command="{Binding SetMotionCommand}" CommandParameter="BatterySaver" Content="Battery saver"/>
                            </StackPanel>
                        </Grid>

                        <!-- 8. Visualizer -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Visualizer" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="What plays beside the artwork on the pill while music plays: bars of square pixels, or smooth rounded bars."
                                           Foreground="#8E929E" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActiveWhitePillBtn}" Command="{Binding SetVisualizerCommand}" CommandParameter="Pixels" Content="Pixels" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DarkPillBtn}" Command="{Binding SetVisualizerCommand}" CommandParameter="Bars" Content="Bars"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#25272E" Margin="0,10,0,20"/>

                        <!-- GENERAL SETTINGS SECTION -->
                        <TextBlock Text="GENERAL" Foreground="#6C707E" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                        <!-- Run at startup -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Run at startup" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Start Zenith Island when you sign in to Windows." Foreground="#8E929E" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding RunAtStartup}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Slim strip under maximized windows -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Slim strip under maximized windows" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Collapse to a thin line so the island never covers browser tabs. Rest the cursor on it to open." Foreground="#8E929E" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding SlimStripUnderMaximizedWindows}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- When the island opens -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="When the island opens" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Last tab opens the card on the tab you were on when it closed, even after a restart. Music always opens on the music card, or on the widgets while nothing is playing. A tab you have turned off is skipped."
                                           Foreground="#8E929E" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActiveWhitePillBtn}" Command="{Binding SetWhenIslandOpensCommand}" CommandParameter="LastTab" Content="Last tab" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DarkPillBtn}" Command="{Binding SetWhenIslandOpensCommand}" CommandParameter="Music" Content="Music"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
